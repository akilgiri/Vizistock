# Copy to .env and fill in your own values. Never commit .env.

# Unique ID for this Pi; must match a camera key in planogram_config.json
CAMERA_ID=cam_0

# Inference server endpoint (e.g. its Tailscale or LAN address)
INFERENCE_SERVER_URL=http://<inference-server-ip>:5000/process_inventory

# Firebase service account JSON and Storage bucket
FIREBASE_CREDENTIALS=firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Optional overrides
POLL_INTERVAL=20
PLANOGRAM_CONFIG=planogram_config.json
FLIP_CAMERA=true
