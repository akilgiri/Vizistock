# Copy to .env and fill in your own values. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Path to your Firebase service account JSON
# (Firebase Console -> Project Settings -> Service Accounts -> Generate new private key)
FIREBASE_CREDENTIALS=firebase-service-account.json

# Firebase Storage bucket, e.g. your-project-id.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# Optional overrides
PLANOGRAM_CONFIG=planogram_config.json
SAM3_WEIGHTS=sam3.pt
ENABLE_DEBUG_STORAGE=true
PORT=5000
